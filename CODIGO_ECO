# 1. ALGORITMOS DE LA CLASE
# ==========================================
def merge_sort(lista):
    if len(lista) > 1:
        medio = len(lista) // 2
        mitad_izq = lista[:medio]
        mitad_der = lista[medio:]
        merge_sort(mitad_izq)
        merge_sort(mitad_der)
        i = j = k = 0
        while i < len(mitad_izq) and j < len(mitad_der):
            if mitad_izq[i]['indice'] < mitad_der[j]['indice']:
                lista[k] = mitad_izq[i]
                i += 1
            else:
                lista[k] = mitad_der[j]
                j += 1
            k += 1
        while i < len(mitad_izq):
            lista[k] = mitad_izq[i]
            i += 1
            k += 1
        while j < len(mitad_der):
            lista[k] = mitad_der[j]
            j += 1
            k += 1

def busqueda_binaria(lista, objetivo):
    inicio = 0
    fin = len(lista) - 1
    while inicio <= fin:
        medio = (inicio + fin) // 2
        if lista[medio]['indice'] == objetivo:
            return lista[medio]
        elif lista[medio]['indice'] < objetivo:
            inicio = medio + 1
        else:
            fin = medio - 1
    return None

# ==========================================
# 2. GESTIÓN DE BASE DE DATOS
# ==========================================
def obtener_inventario():
    conexion = sqlite3.connect('ecosort.db')
    cursor = conexion.cursor()
    cursor.execute('SELECT nombre, descripcion, indice FROM productos')
    filas = cursor.fetchall()
    conexion.close()
    return [{'nombre': f[0], 'descripcion': f[1], 'indice': f[2]} for f in filas]

def buscar_producto_por_nombre(nombre_buscar):
    conexion = sqlite3.connect('ecosort.db')
    cursor = conexion.cursor()
    cursor.execute('SELECT nombre, descripcion, indice FROM productos WHERE nombre LIKE ? OR descripcion LIKE ?', 
                   ('%' + nombre_buscar + '%', '%' + nombre_buscar + '%'))
    filas = cursor.fetchall()
    conexion.close()
    return [{'nombre': f[0], 'descripcion': f[1], 'indice': f[2]} for f in filas]

def agregar_producto_bd(nombre, descripcion, indice):
    conexion = sqlite3.connect('ecosort.db')
    cursor = conexion.cursor()
    cursor.execute('INSERT INTO productos (nombre, descripcion, indice) VALUES (?, ?, ?)', 
                   (nombre, descripcion, indice))
    conexion.commit()
    conexion.close()

def eliminar_producto_bd(nombre_buscar):
    conexion = sqlite3.connect('ecosort.db')
    cursor = conexion.cursor()
    cursor.execute('DELETE FROM productos WHERE nombre LIKE ? OR descripcion LIKE ?', 
                   ('%' + nombre_buscar + '%', '%' + nombre_buscar + '%'))
    filas_borradas = cursor.rowcount
    conexion.commit()
    conexion.close()
    return filas_borradas > 0

# ==========================================
# 3. INTELIGENCIA ARTIFICIAL (Entrenamiento Few-Shot Avanzado)
# ==========================================
def evaluar_con_ia(descripcion):
    prompt = f"""Eres el motor de IA de ECOSORT, experto en sostenibilidad (ODS 12).
Tu única tarea es filtrar y evaluar la entrada del usuario.

REGLAS DE CLASIFICACIÓN ESTRICTA:
- VÁLIDO: Alimentos, bebidas, envases, útiles, artículos de aseo, tecnología de consumo, ropa y productos comerciales de supermercado.
- INVÁLIDO: Código de programación, saludos, animales vivos, personas, vehículos, ciudades, conceptos abstractos o texto sin sentido.

FORMATO DE SALIDA:
Si la entrada es INVÁLIDA, responde EXACTAMENTE:
ESTADO: RECHAZADO

Si la entrada es VÁLIDA, responde EXACTAMENTE:
ESTADO: APROBADO
PUNTAJE: [número 0-100]
ANALISIS: [Breve justificación técnica sobre empaque e impacto, 2 líneas max]

--- EJEMPLOS DE ENTRENAMIENTO (FEW-SHOT) ---
Entrada: 'def fibonacci(n):'
ESTADO: RECHAZADO

Entrada: 'Botella de agua en plástico PET'
ESTADO: APROBADO
PUNTAJE: 10
ANALISIS: El plástico PET de un solo uso tiene alta huella de carbono y contamina ecosistemas.

Entrada: 'Manzana'
ESTADO: APROBADO
PUNTAJE: 100
ANALISIS: Producto orgánico sin empaque, 100% biodegradable.

Entrada: 'hola como estas'
ESTADO: RECHAZADO

Entrada: 'perro'
ESTADO: RECHAZADO
-------------------------------------------

AHORA EVALÚA LA SIGUIENTE ENTRADA:
Entrada: '{descripcion}'
"""
    try:
        # Temperatura 0.0: Hace que la IA sea 100% determinista y lógica, eliminando alucinaciones.
        respuesta = groq_client.chat.completions.create(
            messages=[{"role": "user", "content": prompt}],
            model="qwen/qwen3.8-27b", 
            temperature=0.0,   
        )
        contenido_ia = respuesta.choices[0].message.content.strip()
        print(f"IA Responde:\n{contenido_ia}")
        
        # Filtro de rechazo absoluto
        if "ESTADO: RECHAZADO" in contenido_ia.upper():
            return None, "El texto ingresado no es un producto comercial, envase o alimento válido."

        # Extraer el puntaje
        match_p = re.search(r'PUNTAJE:\s*(\d+)', contenido_ia, re.IGNORECASE)
        puntaje = int(match_p.group(1)) if match_p else 50
            
        # Extraer el análisis
        match_a = re.search(r'ANALISIS:\s*(.*)', contenido_ia, re.IGNORECASE)
        analisis = match_a.group(1).strip() if match_a else "Evaluado según criterios de impacto ambiental."
            
        return max(0, min(100, puntaje)), analisis
    except Exception as e:
        print(f"Error en API Groq: {e}")
        return None, "Error de conexión con el motor de inferencia IA."
