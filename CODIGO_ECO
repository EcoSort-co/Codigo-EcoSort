def generar_menu():
    return ("🌍 *¡Hola! Bienvenido a ECOSORT* 🌍\n\n"
            "Por favor, responde con el *número* de la opción que deseas:\n\n"
            "🔍 *1.* Buscar producto por nombre\n"
            "📋 *2.* Ver lista de productos existentes\n"
            "✨ *3.* Agregar productos (Modo Continuo con IA)\n"
            "🗑️ *4.* Quitar producto\n"
            "ℹ️ *5.* Sobre nosotros\n\n"
            "*(Escribe 'menu' en cualquier momento para volver aquí).*")

@app.route('/whatsapp', methods=['POST'])
def whatsapp():
    # NUEVO: Iniciar cronómetro de latencia apenas entra el mensaje
    tiempo_inicio = time.time() 
    
    mensaje = request.values.get('Body', '').strip()
    mensaje_lower = mensaje.lower()
    respuesta_twilio = MessagingResponse()
    
    estado = session.get('estado', 'inicio')

    if mensaje_lower in ['menu', 'menú', 'inicio', 'hola', 'cancelar', 'salir']:
        session['estado'] = 'inicio'
        respuesta_twilio.message(generar_menu())
        return str(respuesta_twilio)

    if estado == 'inicio':
        if mensaje == '1':
            session['estado'] = 'buscando_nombre'
            respuesta_twilio.message("🔍 *Modo Búsqueda*\nEscribe el *nombre* del producto que deseas buscar:")
        elif mensaje == '2':
            inventario = obtener_inventario()
            merge_sort(inventario)
            if inventario:
                msg = "📋 *Catálogo ECOSORT*\n\n"
                for p in inventario:
                    msg += f"• *{p['nombre']}* — 📊 {p['indice']}/100\n"
                msg += "\nEscribe *'menu'* para regresar."
            else:
                msg = "📋 El inventario está vacío.\nEscribe *'menu'* para regresar."
            respuesta_twilio.message(msg)
        elif mensaje == '3':
            session['estado'] = 'agregando'
            respuesta_twilio.message("✨ *Modo Agregar*\nEnvía los alimentos o productos de consumo que quieras uno tras otro.\n\n_¡Envía el primer producto aquí!_")
        elif mensaje == '4':
            session['estado'] = 'eliminando'
            respuesta_twilio.message("🗑️ *Modo Quitar*\nEscribe el nombre del producto que deseas eliminar:")
        elif mensaje == '5':
            msg = "ℹ️ *Acerca de ECOSORT*\nUtilizamos el motor Llama 3.3 entrenado en ODS 12 y Análisis de Ciclo de Vida para evaluar el impacto de productos comerciales.\nEscribe *'menu'* para regresar."
            respuesta_twilio.message(msg)
        else:
            respuesta_twilio.message("❌ Opción no válida.\n\n" + generar_menu())

    elif estado == 'buscando_nombre':
        resultados = buscar_producto_por_nombre(mensaje)
        if resultados:
            msg = f"✅ *Resultados para '{mensaje}':*\n\n"
            for r in resultados:
                msg += f"🛒 *{r['nombre']}*\n📊 Índice: {r['indice']}/100\n📝 {r['descripcion']}\n\n"
            msg += "Escribe *'menu'* para volver."
        else:
            msg = f"❌ No encontramos *'{mensaje}'*.\nEscribe *'menu'* para volver."
        session['estado'] = 'inicio'
        respuesta_twilio.message(msg)

    elif estado == 'agregando':
        palabras_codigo = ['def ', 'print(', 'return ', 'for ', 'while ', 'import ']
        es_codigo = any(palabra in mensaje_lower for palabra in palabras_codigo)
        
        if es_codigo or '{' in mensaje or '[' in mensaje:
            msg = "❌ *Error:* Hemos detectado código. Ingresa únicamente un alimento o producto comercial.\nEscribe *'menu'* para salir."
            respuesta_twilio.message(msg)
            return str(respuesta_twilio)

        nuevo_indice, analisis_ia = evaluar_con_ia(mensaje)
        
        # Calcular la latencia total del procesamiento
        tiempo_fin = time.time()
        latencia_segundos = round(tiempo_fin - tiempo_inicio, 2)
        
        if nuevo_indice is None:
            msg = (f"⚠️ *Entrada rechazada*\n_{analisis_ia}_\n\n"
                   f"⏱️ _Latencia del filtro: {latencia_segundos}s_\n"
                   "📥 _Envía un alimento válido o escribe *'menu'* para salir._")
        else:
            nombre_corto = mensaje.split(' ')[0].capitalize()
            agregar_producto_bd(nombre_corto, mensaje, nuevo_indice)
            msg = (f"🌟 *¡Producto Evaluado!*\n\n"
                   f"🛒 *Producto:* {mensaje}\n"
                   f"🎯 *Índice:* {nuevo_indice}/100\n\n"
                   f"📋 *Análisis:*\n_{analisis_ia}_\n\n"
                   f"⏱️ _Tiempo de latencia (Inferencia IA): {latencia_segundos} segundos_\n\n"
                   "📥 _Envía otro o escribe *'menu'*._")
               
        respuesta_twilio.message(msg)

    elif estado == 'eliminando':
        borrado_exitoso = eliminar_producto_bd(mensaje)
        if borrado_exitoso:
            msg = f"✅ *'{mensaje}'* ha sido eliminado.\nEscribe *'menu'* para regresar."
        else:
            msg = f"❌ No se encontró *'{mensaje}'*.\nEscribe *'menu'* para regresar."
        session['estado'] = 'inicio'
        respuesta_twilio.message(msg)

    return str(respuesta_twilio)

